{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true, "typeCheck": true },
  "plugins": ["eslint", "typescript", "oxc", "node", "vitest", "unicorn", "jsdoc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", ".agents/**"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}", "tests/**"],
      "env": {
        "vitest": true
      }
    }
  ]
}
